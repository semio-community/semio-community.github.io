---
import { getAllHardware } from "@/data/hardware";
import { getAllResearch } from "@/data/research";
import { getAllSoftware } from "@/data/software";
import SiteShell from "@/layouts/SiteShell.astro";
import ProjectsPage from "@/react-pages/projects/ProjectsPage";
import { siteConfig } from "@/site.config";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { resolveImageLike } from "@/utils/images";
import {
  type ProjectsPageContent,
  buildProjectsPayload,
} from "@semio-community/ecosystem-site-core";

// Site-local image resolution (asset pipelines differ per site), injected
// into the shared `buildProjectsPayload` helper.
const serializeImages = (images?: {
  hero?: unknown;
  logo?: unknown;
  logoUrl?: string;
}) => {
  // biome-ignore lint/suspicious/noExplicitAny: images.hero/logo are unknown types needing runtime resolution
  const hero = resolveImageLike(images?.hero as any);
  // biome-ignore lint/suspicious/noExplicitAny: images.hero/logo are unknown types needing runtime resolution
  const logo = resolveImageLike((images?.logo as any) ?? images?.logoUrl);
  if (!hero && !logo) return undefined;
  return { hero: hero || undefined, logo: logo || undefined };
};

const meta = {
  title: "Projects",
  description:
    "Explore community-driven robotics hardware platforms, open-source software tools, and reproducible research contributions advancing human-robot interaction",
};
const ogImage = "/og/projects.png";

// This site's voice for the projects landing page. The shared layout
// owns none of it; the hero reuses `meta` so the page heading and the
// document description cannot drift apart.
const content: ProjectsPageContent = {
  heading: meta.title,
  intro: meta.description,
  hardware: {
    title: "Hardware Projects",
    description:
      "Community-driven robotics hardware for research and education",
    emptyMessage:
      "Hardware platforms coming soon! Check back later for updates.",
  },
  software: {
    title: "Software Projects",
    description:
      "Comprehensive software tools for every aspect of HRI development",
    emptyMessage:
      "Software packages coming soon! Check back later for updates.",
  },
  research: {
    title: "Research Projects",
    description:
      "Reproducible science and studies advancing the field of human-robot interaction",
    emptyMessage:
      "Research publications coming soon! Check back later for updates.",
  },
};

// Applies featured propagation + serializes `featuring` uniformly, so
// featured stars render consistently across sites. See
// `projects-payload.ts` in site-core.
const featured = await buildFeaturedPropagation();
const projects = buildProjectsPayload({
  hardware: await getAllHardware(),
  software: await getAllSoftware(),
  research: await getAllResearch(),
  featuredPropagation: featured,
  siteKey: siteConfig.siteKey,
  resolveImages: serializeImages,
});
---

    <SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
>
      <ProjectsPage client:load projects={projects} content={content} />
    </SiteShell>

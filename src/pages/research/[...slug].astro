---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import { getRelatedResearch as fetchRelatedResearch } from "@/data/research";
import { getPerson, getFormattedAuthors } from "@/data/people";
import {
  toResearchAuthor,
  ResearchDetail,
  type ResearchOrganizationLink,
  findPressForEntity,
  findAwardsForEntity,
} from "@semio-community/ecosystem-site-core";
import type { ResearchAuthorModel } from "@semio-community/ecosystem-site-core";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { isDraftVisible } from "@/utils/drafts";
import { toOrganizationCardData } from "@/utils/card-mappers";

export async function getStaticPaths() {
  const researchEntries = await getCollection("research", ({ data }) => {
    // In production, exclude drafts. In development, show all.
    return isDraftVisible(data.draft, data.sites);
  });
  return researchEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"research"> };
const { data } = entry;

const relatedResearch = await fetchRelatedResearch(entry, 3);

const authors = data.contributors ?? [];
const authorsString = await getFormattedAuthors(authors);

const meta = {
  title: `${data.title} - Research Study`,
  description: data.description,
};
const ogImage = `/og/research/${entry.id}.png`;

const authorsWithData: ResearchAuthorModel[] = await Promise.all(
  authors.map(async (contributor) => {
    const personEntry = await getPerson(contributor.personId);
    return toResearchAuthor(contributor, personEntry);
  }),
);

const validRoles = new Set(["lead", "affiliated", "funding", "collaborator"]);
const organizationLinks: ResearchOrganizationLink[] = [];

for (const orgLink of data.organizations ?? []) {
  const role = orgLink.role as ResearchOrganizationLink["role"];
  if (!role || !validRoles.has(role)) continue;
  const organization = await getEntry("organizations", orgLink.organizationId);
  if (!organization) continue;
  organizationLinks.push({
    role,
    note: orgLink.note,
    organization: { ...toOrganizationCardData(organization.data), id: organization.id },
  });
}

// Get related hardware
const relatedHardwareItems = data.relatedHardware
  ? await Promise.all(
      data.relatedHardware.map((id) => getEntry("hardware", id)),
    )
  : [];

// Get related software
const relatedSoftwareItems = data.relatedSoftware
  ? await Promise.all(
      data.relatedSoftware.map((id) => getEntry("software", id)),
    )
  : [];

const validRelatedHardware = relatedHardwareItems.filter(
  (item): item is CollectionEntry<"hardware"> => Boolean(item),
);

const validRelatedSoftware = relatedSoftwareItems.filter(
  (item): item is CollectionEntry<"software"> => Boolean(item),
);

// Press items that reference this research via `relatedResearch`.
const allPress = await getCollection("press", ({ data }) =>
  isDraftVisible(data.draft, data.sites),
);
const relatedPress = findPressForEntity(allPress, "research", entry.id);

// Publications produced under this research program: reverse-lookup on
// `press.fromResearch` containing this research entry's id. These are
// rendered as a distinct "Publications" section, separate from generic
// press coverage.
const relatedPublications = allPress.filter(
  (entry_) =>
    entry_.data.type === "publication" &&
    Array.isArray((entry_.data as any).fromResearch) &&
    (entry_.data as any).fromResearch.includes(entry.id),
);

// Awards where this research program is a recipient.
const allAwards = await getCollection("awards", ({ data: awardData }) =>
  isDraftVisible(awardData.draft, awardData.sites),
);
const awards = findAwardsForEntity(allAwards, "research", entry.id);

// Featured-status propagation.
const featured = await buildFeaturedPropagation();
const propagatedData = featured.propagate(entry, "research").data;
const propagatedRelatedResearch = featured.propagateAll(
  relatedResearch,
  "research",
);
---

    <SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
 containerClassName="max-w-5xl"
>
      <ResearchDetail
        data={propagatedData}
        authors={authorsWithData}
        authorsSubtitle={authorsString}
        organizationLinks={organizationLinks}
        relatedHardware={featured.propagateAll(validRelatedHardware, "hardware")}
        relatedSoftware={featured.propagateAll(validRelatedSoftware, "software")}
        relatedResearch={propagatedRelatedResearch}
        relatedPress={relatedPress}
        relatedPublications={relatedPublications}
        awards={awards}
        baseUrl={import.meta.env.BASE_URL}
      />
    </SiteShell>
  </body>
</html>

---
import { getCollection, getEntry } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import { getRelatedHardware } from "@/data/hardware";
import { getPerson } from "@/data/people";
import {
  HardwareDetail,
  findPressForEntity,
  findAwardsForEntity,
} from "@semio-community/ecosystem-site-core";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { isDraftVisible } from "@/utils/drafts";
import { toOrganizationCardData } from "@/utils/card-mappers";

export async function getStaticPaths() {
  const hardware = await getCollection("hardware", ({ data }) => {
    return isDraftVisible(data.draft, data.sites);
  });
  return hardware.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const relatedHardware = await getRelatedHardware(entry, 3);

const meta = {
  title: `${data.name} - Hardware Platform`,
  description: data.description,
};
const ogImage = `/og/hardware/${entry.id}.png`;

const contributors = data.contributors || [];
const peopleContributors = await Promise.all(
  contributors
    .filter((c) => c.type === "person")
    .map(async (contributor) => {
      const personEntry = await getPerson(contributor.personId);
      let currentAffiliation:
        | {
            organizationId: string;
            partnerName?: string;
            role: string;
          }
        | undefined;
      if (personEntry?.data?.affiliations) {
        const current = personEntry.data.affiliations.find(
          (aff) => !aff.endDate,
        );
        if (current) {
          const organization = await getEntry(
            "organizations",
            current.organizationId,
          );
          currentAffiliation = {
            organizationId: current.organizationId,
            partnerName: organization?.data.name || current.organizationId,
            role: current.role,
          };
        }
      }
      const person = personEntry?.data ?? null;
      return {
        ...contributor,
        person,
        currentAffiliation,
      };
    }),
);
const validPeopleContributors = peopleContributors.filter(
  (c) => c.person !== null,
);

const orgContributors = await Promise.all(
  contributors
    .filter((c) => c.type === "organization")
    .map(async (contributor) => {
      const org = await getEntry("organizations", contributor.organizationId);
      return {
        ...contributor,
        data: org?.data ? toOrganizationCardData(org.data) : undefined,
      };
    }),
);

// Press items that reference this hardware via `relatedHardware`.
const allPress = await getCollection("press", ({ data }) =>
  isDraftVisible(data.draft, data.sites),
);
const relatedPress = findPressForEntity(allPress, "hardware", entry.id);

// Awards where this hardware is a recipient.
const allAwards = await getCollection("awards", ({ data: awardData }) =>
  isDraftVisible(awardData.draft, awardData.sites),
);
const awards = findAwardsForEntity(allAwards, "hardware", entry.id);

// Featured-status propagation: scan currently-featured press +
// awards, then augment this entry (and its related-hardware cards)
// so a press item or award lit up by an active `featuring` window
// surfaces as a featured-star on the entities it references.
const featured = await buildFeaturedPropagation();
const propagatedData = featured.propagate(entry, "hardware").data;
const propagatedRelatedHardware = featured.propagateAll(
  relatedHardware,
  "hardware",
);
---

    <SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
 containerClassName="max-w-5xl"
>
      <HardwareDetail
        data={propagatedData}
        organizationContributors={orgContributors}
        peopleContributors={validPeopleContributors}
        relatedHardware={propagatedRelatedHardware}
        relatedPress={relatedPress}
        awards={awards}
        baseUrl={import.meta.env.BASE_URL}
      />
    </SiteShell>
  </body>
</html>

---
import { getCollection } from "astro:content";
import { getAllOrganizations } from "@/data/organizations";
import { getAllPeople } from "@/data/people";
import SiteShell from "@/layouts/SiteShell.astro";
import ContributorsPage from "@/react-pages/contributors/ContributorsPage";
import { toOrganizationCardData, toPersonCardData } from "@/utils/card-mappers";
import { isDraftVisible } from "@/utils/drafts";
import {
  type ContributorsPageOrganizationItem,
  type ContributorsPagePartnerSection,
  type ContributorsPagePersonItem,
  buildOrgDisplayLookup,
  filterHomeOrganization,
  resolvePersonHeadline,
  sortFeaturedFirst,
} from "@semio-community/ecosystem-site-core";
import { siteConfig } from "@/site.config";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { UsersGroupTwoRounded } from "@solar-icons/react-perf/LineDuotone";
import React from "react";

const meta = {
  title: "Contributors",
  description:
    "People and organizations advancing human-centered robotics and AI together",
};
const ogImage = "/og/contributors.png";

const featured = await buildFeaturedPropagation();
const allOrganizations = featured.propagateAll(
  await getAllOrganizations(),
  "organizations",
);
const allPeople = featured.propagateAll(await getAllPeople(), "people");
const organizations = featured.propagateAll(
  await getCollection("organizations", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  ),
  "organizations",
);
const allOrganizationsUnfiltered = await getCollection("organizations");
// Shared org-display resolver — prefers `shortName`, falls back to `name`.
// Used by `resolvePersonHeadline` to turn an affiliation's organizationId
// into a human-readable name. The affiliation's own `organizationName`
// override (when set in the source MDX, e.g. for external orgs like
// "All Tomorrows Institute" that aren't in our orgs collection) still
// wins; this lookup covers the in-collection cases.
const orgDisplayLookup = buildOrgDisplayLookup(allOrganizationsUnfiltered);

function affiliationLabel(person: (typeof allPeople)[number]): string | undefined {
  return resolvePersonHeadline(person.data, {
    homeOrgId: siteConfig.homeOrganizationId,
    orgDisplayLookup,
  }).label;
}

// When true, the dedicated "Board Members" section is hidden and board
// members are rolled into the Community Members list so they still appear.
// When false, the Board Members section renders separately and is excluded
// from the Community list to avoid duplication.
const HIDE_BOARD_SECTION = true;
const boardMembers = sortFeaturedFirst(
  allPeople.filter((p) => p.data.isContributor && p.data.boardMember),
);
const communityMembers = sortFeaturedFirst(
  allPeople.filter(
    (p) =>
      p.data.isContributor && (HIDE_BOARD_SECTION ? true : !p.data.boardMember),
  ),
);

const donorPeople = sortFeaturedFirst(allPeople.filter((p) => p.data.isDonor));
const donorOrganizations = sortFeaturedFirst(
  organizations.filter((org) => org.data.isDonor),
);
const grantMakers = sortFeaturedFirst(
  organizations.filter((org) => org.data.isGrantMaker),
);

const partnerTypeInfo: Record<
  string,
  { title: string; icon: string; description: string }
> = {
  industry: {
    title: "Industry Partners",
    icon: "solar:buildings-2-line-duotone",
    description: "Companies driving innovation in robotics and AI",
  },
  nonprofit: {
    title: "Non-Profit Partners",
    icon: "solar:hand-shake-line-duotone",
    description: "Organizations advancing social impact through technology",
  },
  academic: {
    title: "Academic Partners",
    icon: "solar:square-academic-cap-line-duotone",
    description: "Leading universities and research institutions",
  },
  government: {
    title: "Government Partners",
    icon: "solar:flag-2-line-duotone",
    description: "Public sector organizations and agencies",
  },
};
const orderedPartnerTypes = ["industry", "nonprofit", "academic", "government"];

const visiblePartners = sortFeaturedFirst(
  filterHomeOrganization(allOrganizations, siteConfig),
);
const partnersByType: Record<string, typeof allOrganizations> = {};
for (const partner of visiblePartners) {
  if (!partnersByType[partner.data.type]) {
    partnersByType[partner.data.type] = [];
  }
  partnersByType[partner.data.type]?.push(partner);
}

const mappedBoardMembers: ContributorsPagePersonItem[] = boardMembers.map((p) => ({
  id: p.id,
  data: toPersonCardData(p.data),
  affiliationLabel: affiliationLabel(p),
}));

const mappedCommunityMembers: ContributorsPagePersonItem[] = communityMembers.map((p) => ({
  id: p.id,
  data: toPersonCardData(p.data),
  affiliationLabel: affiliationLabel(p),
}));

const mappedPartnerSections: ContributorsPagePartnerSection[] = [
  ...orderedPartnerTypes,
  ...Object.keys(partnersByType).filter(
    (type) => !orderedPartnerTypes.includes(type),
  ),
].map((type) => ({
  type,
  info: partnerTypeInfo[type] ?? null,
  partners: (partnersByType[type] ?? []).map((o): ContributorsPageOrganizationItem => ({
    id: o.id,
    data: toOrganizationCardData(o.data),
  })),
}));

const mappedDonorPeople: ContributorsPagePersonItem[] = donorPeople.map((p) => ({
  id: p.id,
  data: toPersonCardData(p.data),
}));

const mappedDonorOrganizations: ContributorsPageOrganizationItem[] = donorOrganizations.map((o) => ({
  id: o.id,
  data: toOrganizationCardData(o.data),
}));

const mappedGrantMakers: ContributorsPageOrganizationItem[] = grantMakers.map((o) => ({
  id: o.id,
  data: toOrganizationCardData(o.data),
}));

const heroIcon = React.createElement(UsersGroupTwoRounded, { className: "w-16 h-16 text-accent-two" });
---

    <SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
 containerClassName="max-w-6xl"
>
      <ContributorsPage
        meta={meta}
        hideBoardMembers={HIDE_BOARD_SECTION}
        boardMembers={mappedBoardMembers}
        communityMembers={mappedCommunityMembers}
        partnerSections={mappedPartnerSections}
        donorPeople={mappedDonorPeople}
        donorOrganizations={mappedDonorOrganizations}
        grantMakers={mappedGrantMakers}
        heroIcon={heroIcon}
        baseUrl={import.meta.env.BASE_URL}
        homeOrgId={siteConfig.homeOrganizationId}
        orgDisplayLookup={orgDisplayLookup}
      />
    </SiteShell>
  </body>
</html>

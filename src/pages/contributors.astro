---
import { getCollection } from "astro:content";
import { getAllOrganizations } from "@/data/organizations";
import { getAllPeople } from "@/data/people";
import SiteShell from "@/layouts/SiteShell.astro";
import ContributorsPage from "@/react-pages/contributors/ContributorsPage";
import { isDraftVisible } from "@/utils/drafts";
import { siteConfig } from "@/site.config";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import {
  prepareContributorsPayload,
  type PartnerTypeCopy,
} from "@semio-community/ecosystem-site-core";
import { UsersGroupTwoRounded } from "@solar-icons/react-perf/LineDuotone";
import React from "react";

const meta = {
  title: "Contributors",
  description: "People and organizations advancing human-centered robotics and AI together",
};
const ogImage = "/og/contributors.png";

// When true the dedicated "Board Members" section is hidden and board
// members are rolled into the Community Members list so they still appear.
const HIDE_BOARD_SECTION = true;

// Partner section copy is content, so it lives here rather than in the
// shared payload builder.
const PARTNER_TYPE_ORDER = ["industry", "nonprofit", "academic", "government"];
const PARTNER_TYPE_COPY: Record<string, PartnerTypeCopy> = {
  industry: {
    title: "Industry Partners",
    icon: "solar:buildings-2-line-duotone",
    description: "Companies driving innovation in robotics and AI",
  },
  nonprofit: {
    title: "Non-Profit Partners",
    icon: "solar:hand-shake-line-duotone",
    description: "Organizations advancing social impact through technology",
  },
  academic: {
    title: "Academic Partners",
    icon: "solar:square-academic-cap-line-duotone",
    description: "Leading universities and research institutions",
  },
  government: {
    title: "Government Partners",
    icon: "solar:flag-2-line-duotone",
    description: "Public sector organizations and agencies",
  },
};

const [featured, allPeople, allOrganizations, visibleOrganizations, allOrganizationsUnfiltered] =
  await Promise.all([
    buildFeaturedPropagation(),
    getAllPeople(),
    getAllOrganizations(),
    getCollection("organizations", ({ data }) =>
      isDraftVisible(data.draft, data.sites),
    ),
    getCollection("organizations"),
  ]);

const payload = prepareContributorsPayload({
  allPeople,
  allOrganizations,
  visibleOrganizations,
  allOrganizationsUnfiltered,
  featured,
  homeOrganizationId: siteConfig.homeOrganizationId,
  suppressOrganizationPage: siteConfig.suppressOrganizationPage,
  siteKey: siteConfig.siteKey,
  hideBoardSection: HIDE_BOARD_SECTION,
  partnerTypes: { order: PARTNER_TYPE_ORDER, copy: PARTNER_TYPE_COPY },
});

const heroIcon = React.createElement(UsersGroupTwoRounded, {
  className: "w-16 h-16 text-accent-two",
});
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-6xl"
>
  <ContributorsPage
    meta={meta}
    hideBoardMembers={HIDE_BOARD_SECTION}
    boardMembers={payload.boardMembers}
    communityMembers={payload.communityMembers}
    partnerSections={payload.partnerSections}
    donorPeople={payload.donorPeople}
    donorOrganizations={payload.donorOrganizations}
    grantMakers={payload.grantMakers}
    heroIcon={heroIcon}
    baseUrl={import.meta.env.BASE_URL}
    homeOrgId={siteConfig.homeOrganizationId}
    orgDisplayLookup={payload.orgDisplayLookup}
  />
</SiteShell>
